{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianBingzhuo/Jiaowu2K26/app/contracts/v1/coach-scouting-fixture.schema.json",
  "title": "University2K26 F-007 sourced Coach and Scouting fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_mode",
    "generated_at",
    "last_updated_at",
    "course",
    "sources",
    "teaching",
    "office_hours",
    "workload",
    "scouting",
    "versions",
    "feedback_aggregates",
    "team_fields",
    "team_needs",
    "reminders",
    "audit",
    "invariants"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "data_mode": { "const": "demo_fixture" },
    "generated_at": { "type": "string", "format": "date-time" },
    "last_updated_at": { "type": "string", "format": "date-time" },
    "course": { "$ref": "#/$defs/course" },
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/source" }
    },
    "teaching": { "$ref": "#/$defs/teaching" },
    "office_hours": {
      "type": "array",
      "minItems": 2,
      "contains": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "const": "expired" } }
      },
      "items": { "$ref": "#/$defs/officeHours" }
    },
    "workload": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/workload" }
    },
    "scouting": { "$ref": "#/$defs/scouting" },
    "versions": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/version" }
    },
    "feedback_aggregates": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/feedbackAggregate" }
    },
    "team_fields": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/teamField" }
    },
    "team_needs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/teamNeed" }
    },
    "reminders": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/reminder" }
    },
    "audit": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/auditEvent" }
    },
    "invariants": { "$ref": "#/$defs/invariants" }
  },
  "not": {
    "anyOf": [
      { "required": ["teacher_rating"] },
      { "required": ["teacher_score"] },
      { "required": ["personality_label"] },
      { "required": ["advisor_prediction"] },
      { "required": ["class_rank"] }
    ]
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nullableDateTime": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "label",
        "owner",
        "version",
        "updated_at",
        "expires_at",
        "correction_route",
        "verified"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^src-" },
        "tier": {
          "enum": [
            "teacher_confirmed",
            "official_syllabus",
            "historical_version",
            "student_aggregate",
            "system_inference"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "format": "date-time" },
        "expires_at": { "$ref": "#/$defs/nullableDateTime" },
        "correction_route": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" }
      }
    },
    "sourcedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "source_id", "effective_term"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "pattern": "^src-" },
        "effective_term": { "type": "string", "minLength": 1 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "weight", "source_id"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "source_id": { "type": "string", "pattern": "^src-" }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "course_id",
        "offering_id",
        "term",
        "title",
        "instructor_id",
        "instructor_assignment_id",
        "instructor_display_name",
        "summary",
        "objectives",
        "assessments",
        "textbooks",
        "prerequisites",
        "updated_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^course-profile-" },
        "course_id": { "type": "string", "minLength": 1 },
        "offering_id": { "type": "string", "pattern": "^offering-" },
        "term": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "instructor_id": { "type": "string", "pattern": "^faculty-" },
        "instructor_assignment_id": {
          "type": "string",
          "pattern": "^assignment-"
        },
        "instructor_display_name": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/sourcedField" },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourcedField" }
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assessment" }
        },
        "textbooks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourcedField" }
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourcedField" }
        },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "share", "frequency", "source_id"],
      "properties": {
        "id": { "type": "string", "pattern": "^activity-" },
        "label": { "type": "string", "minLength": 1 },
        "share": { "type": "integer", "minimum": 0, "maximum": 100 },
        "frequency": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "pattern": "^src-" }
      }
    },
    "teaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offering_id",
        "activities",
        "homework_frequency",
        "feedback_method",
        "group_share"
      ],
      "properties": {
        "offering_id": { "type": "string", "pattern": "^offering-" },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/activity" }
        },
        "homework_frequency": { "$ref": "#/$defs/sourcedField" },
        "feedback_method": { "$ref": "#/$defs/sourcedField" },
        "group_share": { "$ref": "#/$defs/sourcedField" }
      }
    },
    "officeHours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "instructor_assignment_id",
        "schedule",
        "location",
        "appointment_method",
        "suitable_topics",
        "accessibility",
        "source_id",
        "updated_at",
        "expires_at",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^office-hours-" },
        "instructor_assignment_id": {
          "type": "string",
          "pattern": "^assignment-"
        },
        "schedule": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "appointment_method": { "type": "string", "minLength": 1 },
        "suitable_topics": { "$ref": "#/$defs/stringArray" },
        "accessibility": { "$ref": "#/$defs/stringArray" },
        "source_id": { "type": "string", "pattern": "^src-" },
        "updated_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["active", "expired"] }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "minimum",
        "maximum",
        "unit",
        "sample_size",
        "minimum_sample",
        "time_range",
        "source_id",
        "publishable",
        "caveat"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^workload-" },
        "label": { "type": "string", "minLength": 1 },
        "minimum": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 },
        "unit": { "const": "hours_per_week" },
        "sample_size": { "type": ["integer", "null"], "minimum": 0 },
        "minimum_sample": { "type": ["integer", "null"], "minimum": 1 },
        "time_range": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "pattern": "^src-" },
        "publishable": { "type": "boolean" },
        "caveat": { "type": "string", "minLength": 1 }
      }
    },
    "scouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offering_id",
        "prepared_for",
        "challenges",
        "actions",
        "unknowns"
      ],
      "properties": {
        "offering_id": { "type": "string", "pattern": "^offering-" },
        "prepared_for": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourcedField" }
        },
        "challenges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourcedField" }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourcedField" }
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourcedField" }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "course_id",
        "offering_id",
        "term",
        "instructor_id",
        "instructor_assignment_id",
        "profile_version",
        "assessment_summary",
        "teaching_summary",
        "source_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^version-" },
        "course_id": { "type": "string", "minLength": 1 },
        "offering_id": { "type": "string", "pattern": "^offering-" },
        "term": { "type": "string", "minLength": 1 },
        "instructor_id": { "type": "string", "pattern": "^faculty-" },
        "instructor_assignment_id": {
          "type": "string",
          "pattern": "^assignment-"
        },
        "profile_version": { "type": "string", "minLength": 1 },
        "assessment_summary": { "type": "string", "minLength": 1 },
        "teaching_summary": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^src-" }
        }
      }
    },
    "feedbackAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "offering_id",
        "dimension",
        "sample_size",
        "minimum_sample",
        "time_range",
        "summary",
        "suggested_action",
        "source_id",
        "published"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^aggregate-" },
        "offering_id": { "type": "string", "pattern": "^offering-" },
        "dimension": { "type": "string", "minLength": 1 },
        "sample_size": { "type": "integer", "minimum": 0 },
        "minimum_sample": { "type": "integer", "minimum": 5 },
        "time_range": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "suggested_action": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "pattern": "^src-" },
        "published": { "type": "boolean" }
      }
    },
    "teamField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "value",
        "selectable",
        "private"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^team-" },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["skill", "availability", "communication", "sensitive"]
        },
        "value": { "type": "string", "minLength": 1 },
        "selectable": { "type": "boolean" },
        "private": { "const": true }
      }
    },
    "teamNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "offering_id",
        "project_title",
        "role_gap",
        "skills",
        "hours_per_week",
        "communication",
        "source_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^need-" },
        "offering_id": { "type": "string", "pattern": "^offering-" },
        "project_title": { "type": "string", "minLength": 1 },
        "role_gap": { "type": "string", "minLength": 1 },
        "skills": { "$ref": "#/$defs/stringArray" },
        "hours_per_week": { "type": "integer", "minimum": 1 },
        "communication": { "$ref": "#/$defs/stringArray" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^src-" }
        }
      }
    },
    "reminder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "offering_id",
        "reminder_type",
        "title",
        "detail",
        "due_at",
        "source_id",
        "required"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^reminder-" },
        "offering_id": { "type": "string", "pattern": "^offering-" },
        "reminder_type": {
          "enum": ["equipment", "material", "attendance", "safety"]
        },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "due_at": { "type": "string", "format": "date-time" },
        "source_id": { "type": "string", "pattern": "^src-" },
        "required": { "type": "boolean" }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "action",
        "target_id",
        "detail",
        "occurred_at",
        "previous_event_hash",
        "event_hash"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^coach-event-" },
        "sequence": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "minLength": 1 },
        "target_id": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "previous_event_hash": { "type": ["string", "null"] },
        "event_hash": { "type": "string", "pattern": "^fnv1a-coach-event-" }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_teacher_rating",
        "no_personality_labels",
        "separate_course_and_teacher",
        "no_feedback_carry_forward",
        "minimum_feedback_sample",
        "no_sensitive_team_matching",
        "no_fabricated_advisor_reply",
        "severe_content_hidden_first"
      ],
      "properties": {
        "no_teacher_rating": { "const": true },
        "no_personality_labels": { "const": true },
        "separate_course_and_teacher": { "const": true },
        "no_feedback_carry_forward": { "const": true },
        "minimum_feedback_sample": { "type": "integer", "minimum": 5 },
        "no_sensitive_team_matching": { "const": true },
        "no_fabricated_advisor_reply": { "const": true },
        "severe_content_hidden_first": { "const": true }
      }
    }
  }
}
