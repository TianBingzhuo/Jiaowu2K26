FROM node:24-bookworm-slim AS build

WORKDIR /workspace
COPY app ./app
RUN npm ci --prefix app/apps/web \
    && npm run build --prefix app/apps/web

FROM nginx:1.30.4-alpine3.24 AS runtime

COPY deploy/gx10/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /workspace/app/apps/web/dist /usr/share/nginx/html

USER nginx
ENTRYPOINT ["nginx", "-g", "daemon off;"]
