{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianBingzhuo/Jiaowu2K26/app/contracts/v1/ai-status.schema.json",
  "title": "University2K26 AI gateway status without credentials",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configured",
    "provider",
    "model",
    "credential_source",
    "local_first_supported",
    "detail"
  ],
  "properties": {
    "configured": { "type": "boolean" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "credential_source": {
      "enum": [
        "J2K26_AI_API_KEY",
        "MOONSHOT_API_KEY",
        "none_loopback",
        "not_configured"
      ]
    },
    "local_first_supported": { "const": true },
    "detail": { "type": "string", "minLength": 1 }
  },
  "not": {
    "anyOf": [
      { "required": ["api_key"] },
      { "required": ["authorization"] },
      { "required": ["secret"] }
    ]
  }
}
