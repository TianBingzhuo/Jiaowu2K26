{
  "name": "university2k26-web",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 121",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fluentui/react-icons": "2.0.333",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "intl-messageformat": "11.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
