{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianBingzhuo/Jiaowu2K26/app/contracts/v1/opportunity-market-session.schema.json",
  "title": "University2K26 F-009 Opportunity Market controlled session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_mode",
    "student_id",
    "selected_profile_field_ids",
    "eligibility_checks",
    "match_results",
    "saved_opportunities",
    "disclosure_grants",
    "application_mirrors",
    "capacity_plans",
    "selected_pathway_id",
    "selected_portfolio_artifact_ids",
    "reports",
    "fairness_audits",
    "suppressed_opportunity_ids",
    "read_only_cache_available",
    "authoritative",
    "audit"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "data_mode": { "const": "demo_fixture" },
    "student_id": { "type": "string", "minLength": 1 },
    "selected_profile_field_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^field-" }
    },
    "eligibility_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/eligibilityCheck" }
    },
    "match_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/matchResult" }
    },
    "saved_opportunities": {
      "type": "array",
      "items": { "$ref": "#/$defs/savedOpportunity" }
    },
    "disclosure_grants": {
      "type": "array",
      "items": { "$ref": "#/$defs/disclosureGrant" }
    },
    "application_mirrors": {
      "type": "array",
      "items": { "$ref": "#/$defs/applicationMirror" }
    },
    "capacity_plans": {
      "type": "array",
      "items": { "$ref": "#/$defs/capacityPlan" }
    },
    "selected_pathway_id": { "type": ["string", "null"] },
    "selected_portfolio_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^artifact-" }
    },
    "reports": {
      "type": "array",
      "items": { "$ref": "#/$defs/report" }
    },
    "fairness_audits": {
      "type": "array",
      "items": { "$ref": "#/$defs/fairnessAudit" }
    },
    "suppressed_opportunity_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^opp-" }
    },
    "read_only_cache_available": { "const": true },
    "authoritative": { "const": false },
    "audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "opportunity-market-fixture.schema.json#/$defs/auditEvent"
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["auto_apply"] },
      { "required": ["composite_score"] },
      { "required": ["paid_ranking_factor"] },
      { "required": ["financial_account"] }
    ]
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "eligibilityResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_description",
        "status",
        "evidence_field_id",
        "evidence_label",
        "next_step"
      ],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^rule-" },
        "rule_description": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["met", "possibly_met", "not_met", "unknown"]
        },
        "evidence_field_id": { "type": ["string", "null"] },
        "evidence_label": { "type": "string", "minLength": 1 },
        "next_step": { "type": "string", "minLength": 1 }
      }
    },
    "eligibilityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "checked_at",
        "used_profile_field_ids",
        "results",
        "summary",
        "has_composite_score"
      ],
      "properties": {
        "opportunity_id": { "type": "string", "pattern": "^opp-" },
        "checked_at": { "type": "string", "format": "date-time" },
        "used_profile_field_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^field-" }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/eligibilityResult" }
        },
        "summary": { "type": "string", "minLength": 1 },
        "has_composite_score": { "const": false }
      }
    },
    "matchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "fit_band",
        "reasons",
        "conflicts",
        "unknowns",
        "generated_at",
        "ranking_basis",
        "paid_influence"
      ],
      "properties": {
        "opportunity_id": { "type": "string", "pattern": "^opp-" },
        "fit_band": {
          "enum": [
            "ready_to_review",
            "needs_confirmation",
            "gaps_present",
            "insufficient_data"
          ]
        },
        "reasons": { "$ref": "#/$defs/stringArray" },
        "conflicts": { "$ref": "#/$defs/stringArray" },
        "unknowns": { "$ref": "#/$defs/stringArray" },
        "generated_at": { "type": "string", "format": "date-time" },
        "ranking_basis": { "const": "eligibility_then_deadline" },
        "paid_influence": { "const": false }
      }
    },
    "savedOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "note",
        "saved_at",
        "intent_status",
        "updated_at"
      ],
      "properties": {
        "opportunity_id": { "type": "string", "pattern": "^opp-" },
        "note": { "type": "string" },
        "saved_at": { "type": "string", "format": "date-time" },
        "intent_status": {
          "enum": ["saved", "student_interested", "mutual_interest", "withdrawn"]
        },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "disclosureGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "opportunity_id",
        "recipient",
        "purpose",
        "profile_field_ids",
        "preview",
        "granted_at",
        "expires_at",
        "revoked_at"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^disclosure-" },
        "opportunity_id": { "type": "string", "pattern": "^opp-" },
        "recipient": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "profile_field_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^field-" }
        },
        "preview": { "$ref": "#/$defs/stringArray" },
        "granted_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "revoked_at": { "type": ["string", "null"] }
      }
    },
    "applicationMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "opportunity_id",
        "status",
        "shared_field_ids",
        "external_application_url",
        "updated_at",
        "authoritative"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^application-" },
        "opportunity_id": { "type": "string", "pattern": "^opp-" },
        "status": {
          "enum": [
            "discovered",
            "saved",
            "consented",
            "applied_externally",
            "outcome_recorded"
          ]
        },
        "shared_field_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^field-" }
        },
        "external_application_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "updated_at": { "type": "string", "format": "date-time" },
        "authoritative": { "const": false }
      }
    },
    "capacityPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "hours_per_week",
        "note",
        "created_at"
      ],
      "properties": {
        "opportunity_id": { "type": "string", "pattern": "^opp-" },
        "hours_per_week": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "opportunity_id",
        "report_type",
        "reason",
        "status",
        "created_at",
        "affected_match_recalculated"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^report-" },
        "opportunity_id": { "type": "string", "pattern": "^opp-" },
        "report_type": { "enum": ["expired", "wrong_info", "unfair"] },
        "reason": { "type": "string", "minLength": 1 },
        "status": { "const": "queued_for_human_review" },
        "created_at": { "type": "string", "format": "date-time" },
        "affected_match_recalculated": { "const": true }
      }
    },
    "fairnessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "detail"],
      "properties": {
        "id": { "type": "string", "pattern": "^fair-" },
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "fairnessAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "run_at",
        "checks",
        "sensitive_fields_used",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^fairness-" },
        "run_at": { "type": "string", "format": "date-time" },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/fairnessCheck" }
        },
        "sensitive_fields_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "enum": ["pass", "fail"] }
      }
    }
  }
}
