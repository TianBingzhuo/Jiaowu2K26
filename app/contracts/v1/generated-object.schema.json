{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianBingzhuo/Jiaowu2K26/app/contracts/v1/generated-object.schema.json",
  "title": "GeneratedObject v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "course_id",
    "kind",
    "body",
    "source_ids",
    "evidence",
    "evidence_status",
    "unknowns",
    "generation_mode",
    "generator_version",
    "review_state",
    "revision",
    "fixture"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "id": { "type": "string", "minLength": 1 },
    "course_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "evidence_status": { "type": "string", "minLength": 1 },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "generation_mode": {
      "type": "string",
      "description": "Known v1 values are model, rule, and fixture; unknown future values must be preserved."
    },
    "generator_version": { "type": "string", "minLength": 1 },
    "review_state": {
      "type": "string",
      "description": "Known v1 values are draft, review, approved, removed, rejected, published, and withdrawn. Unknown values block automatic action."
    },
    "revision": { "type": "integer", "minimum": 0 },
    "fixture": { "type": "boolean" }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": [
        "id",
        "source_fragment_id",
        "source_ref",
        "source_type",
        "quote",
        "summary",
        "confidence",
        "teacher_action"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_fragment_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "quote": { "type": "string" },
        "summary": { "type": "string" },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "teacher_action": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
