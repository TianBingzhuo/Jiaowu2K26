{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://university2k26.local/contracts/v1/roster-catalog-import-receipt.schema.json",
  "title": "University2K26 course-catalog validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "validation_status",
    "institution",
    "dataset_scope",
    "catalog_channel",
    "catalog_version",
    "checksum_sha256",
    "records_validated",
    "warnings",
    "imported",
    "persisted",
    "contains_enrollment_records",
    "is_formal_enrollment",
    "source_boundary"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_id": { "type": "string", "pattern": "^catalog-validation-" },
    "validation_status": { "const": "validated_only" },
    "institution": { "enum": ["uarizona", "hebut"] },
    "dataset_scope": {
      "enum": ["public_course_catalog", "user_authorized_course_catalog"]
    },
    "catalog_channel": { "type": "string", "minLength": 1 },
    "catalog_version": { "type": "string", "minLength": 1 },
    "checksum_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "records_validated": { "type": "integer", "minimum": 1, "maximum": 500 },
    "warnings": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "imported": { "const": false },
    "persisted": { "const": false },
    "contains_enrollment_records": { "const": false },
    "is_formal_enrollment": { "const": false },
    "source_boundary": { "type": "string", "minLength": 40 }
  }
}
