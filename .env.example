# Safe local defaults. Copy to .env only when a component explicitly needs it.
J2K26_ENV=development
J2K26_HOST=127.0.0.1
J2K26_PORT=24126
J2K26_DATABASE_KIND=sqlite
J2K26_DATABASE_URL=sqlite://.data/jiaowu2k26.db
J2K26_AI_PROVIDER=fixture
J2K26_LOG_LEVEL=info

# Conditional adapters remain disabled until their Gate experiments pass.
# J2K26_OCEANBASE_URL=mysql://replace-with-local-secret
# J2K26_MODEL_ENDPOINT=https://replace-with-approved-provider
