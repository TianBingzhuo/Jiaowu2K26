{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianBingzhuo/Jiaowu2K26/app/contracts/v1/ai-advice-request.schema.json",
  "title": "University2K26 source-bound AI advice request",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "subject", "question", "locale", "facts"],
  "properties": {
    "task": {
      "enum": [
        "student_support_case",
        "teaching_improvement",
        "curriculum_impact",
        "policy_impact",
        "career_path",
        "opportunity_brief",
        "course_explanation"
      ]
    },
    "subject": { "type": "string", "minLength": 1, "maxLength": 160 },
    "question": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "locale": { "type": "string", "minLength": 2, "maxLength": 20 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "source_id"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "value": { "type": "string", "minLength": 1, "maxLength": 800 },
          "source_id": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["api_key"] },
      { "required": ["provider_url"] },
      { "required": ["formal_decision"] }
    ]
  }
}
