# Safe development values for variables the current V0.9 runtime actually reads.
# The repository does not automatically load the root .env file. Prefer the
# checked-in start scripts, or export temporary overrides in the current shell.
J2K26_BIND=127.0.0.1:3000
J2K26_DATABASE_URL=sqlite://.data/j2k26-phase0.db?mode=rwc
VITE_API_ORIGIN=http://127.0.0.1:3000
RUST_LOG=info

# Optional private, de-identified development context. The default runtime path
# is .data/university2k26/private-profile.json, which is ignored by Git.
# J2K26_PRIVATE_PROFILE_PATH=.data/university2k26/private-profile.json

# Provider-neutral OpenAI-compatible AI adapter. With no credential, every AI
# endpoint returns an explicitly labelled deterministic rules_fallback.
# Moonshot cloud example:
# J2K26_AI_PROVIDER=moonshot
# J2K26_AI_BASE_URL=https://api.moonshot.cn/v1
# J2K26_AI_MODEL=kimi-k2.6
# J2K26_AI_THINKING=disabled
# Export MOONSHOT_API_KEY only in the server process environment.
# On Windows, prefer scripts/Configure-University2K26-AI.ps1: it prompts for
# the key without echo and stores only a current-user DPAPI-encrypted blob in
# the ignored .data directory. "disabled" is the low-latency K2.6 Fast path;
# use "enabled" only for a deliberately deeper, more expensive request.
#
# GX10 / local sovereign endpoint example. Plain HTTP is accepted only for an
# explicit loopback address:
# J2K26_AI_PROVIDER=gx10-local
# J2K26_AI_BASE_URL=http://127.0.0.1:8000/v1
# J2K26_AI_MODEL=replace-with-verified-local-model-id
# J2K26_AI_AUTH_MODE=none
# Use auth mode none only on loopback. Otherwise export J2K26_AI_API_KEY in the
# server process environment and keep the default bearer mode.

# Reserved adapters: not production-ready in V0.9.
# J2K26_OCEANBASE_URL=mysql://replace-with-local-secret

# Never add an API key to this tracked example, a CLI argument, or browser
# URL/storage. The Web client never reads provider credentials.
