{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://university2k26.local/contracts/v1/roster-catalog-import-request.schema.json",
  "title": "University2K26 course-catalog validation request",
  "description": "Strict validation-only envelope. Unknown fields are rejected so enrollment, grade, payment or identity records cannot be smuggled into the catalog path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "institution",
    "dataset_scope",
    "source_locator",
    "retrieved_at",
    "terms_version",
    "use_basis",
    "checksum_sha256",
    "catalog_version",
    "courses"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "institution": { "enum": ["uarizona", "hebut"] },
    "dataset_scope": {
      "enum": ["public_course_catalog", "user_authorized_course_catalog"]
    },
    "source_locator": { "type": "string", "minLength": 8, "maxLength": 300 },
    "retrieved_at": { "type": "string", "minLength": 8, "maxLength": 64 },
    "terms_version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "use_basis": { "type": "string", "minLength": 3, "maxLength": 240 },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "catalog_version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "courses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/course" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "institution": { "const": "uarizona" } },
        "required": ["institution"]
      },
      "then": {
        "properties": {
          "dataset_scope": { "const": "public_course_catalog" },
          "source_locator": {
            "pattern": "^https://(catalog|uaccess\\.schedule)\\.arizona\\.edu/"
          }
        }
      }
    }
  ],
  "$defs": {
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_code",
        "title",
        "credits",
        "department",
        "prerequisites",
        "corequisites",
        "exclusions",
        "offered_terms"
      ],
      "properties": {
        "course_code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "credits": { "type": "number", "minimum": 0, "maximum": 30 },
        "department": { "type": "string", "minLength": 1, "maxLength": 120 },
        "prerequisites": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 120 }
        },
        "corequisites": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 120 }
        },
        "exclusions": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 120 }
        },
        "offered_terms": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 64 }
        }
      }
    }
  }
}
