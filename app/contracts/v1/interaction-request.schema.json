{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://university2k26.local/contracts/v1/interaction-request.schema.json",
  "title": "University2K26 Student Interaction Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actor_id",
    "interaction_type"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\."
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "interaction_type": {
      "type": "string",
      "minLength": 1
    },
    "selected_answer": {
      "type": "string",
      "minLength": 1
    },
    "correct": {
      "type": "boolean"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
