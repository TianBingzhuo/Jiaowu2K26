{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://university2k26.local/contracts/v1/semester-lock.schema.json",
  "title": "University2K26 F-004 replayable semester lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_mode",
    "id",
    "student_id",
    "semester",
    "catalog_version",
    "prefix_version",
    "pin_ids",
    "preferences",
    "goal_order",
    "solver_backend",
    "selected_plan_id",
    "input_fingerprint",
    "created_at",
    "is_formal_enrollment",
    "source_boundary"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "data_mode": { "const": "fixture" },
    "id": { "type": "string", "pattern": "^semester-lock-" },
    "student_id": { "const": "student-nan-fixture" },
    "semester": { "type": "string", "minLength": 1 },
    "catalog_version": { "type": "string", "minLength": 1 },
    "prefix_version": { "type": "integer", "minimum": 1 },
    "pin_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^pin-" }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_of_day", "compactness", "variety", "stability"],
      "properties": {
        "time_of_day": { "enum": ["morning", "daytime", "late"] },
        "compactness": { "type": "integer", "minimum": 0, "maximum": 3 },
        "variety": { "type": "integer", "minimum": 0, "maximum": 3 },
        "stability": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "goal_order": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "hard_constraints",
          "graduation_progress",
          "minimal_change",
          "personal_preference",
          "minimal_gaps"
        ]
      }
    },
    "solver_backend": { "const": "deterministic_heuristic_fixture" },
    "selected_plan_id": { "type": "string", "minLength": 1 },
    "input_fingerprint": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "is_formal_enrollment": { "const": false },
    "source_boundary": { "type": "string", "minLength": 40 }
  }
}
