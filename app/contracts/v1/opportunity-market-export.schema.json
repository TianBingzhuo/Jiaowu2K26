{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianBingzhuo/Jiaowu2K26/app/contracts/v1/opportunity-market-export.schema.json",
  "title": "University2K26 F-009 readable untrusted opportunity portfolio export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "archive_type",
    "generated_at",
    "student_id",
    "private",
    "authoritative",
    "artifacts",
    "warning"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "archive_type": {
      "const": "readable_untrusted_portfolio_fixture"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "student_id": { "type": "string", "minLength": 1 },
    "private": { "const": true },
    "authoritative": { "const": false },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "opportunity-market-fixture.schema.json#/$defs/portfolioArtifact"
      }
    },
    "warning": { "type": "string", "minLength": 80 }
  },
  "not": {
    "anyOf": [
      { "required": ["issuer"] },
      { "required": ["signature_status"] },
      { "required": ["institutional_credential"] },
      { "required": ["original_course_material"] }
    ]
  }
}
