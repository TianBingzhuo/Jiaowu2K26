{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianBingzhuo/Jiaowu2K26/app/contracts/v1/campus-pass-session.schema.json",
  "title": "University2K26 Campus Pass Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_mode",
    "selected_credential_id",
    "presentations",
    "access_requests",
    "guest_pass_drafts",
    "loss_cases",
    "log_corrections",
    "offline_checks",
    "manual_fallback_selections",
    "audit"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "data_mode": { "const": "demo_fixture" },
    "selected_credential_id": { "type": ["string", "null"] },
    "presentations": { "type": "array", "items": { "$ref": "#/$defs/presentation" } },
    "access_requests": { "type": "array", "items": { "$ref": "#/$defs/request" } },
    "guest_pass_drafts": { "type": "array", "items": { "$ref": "#/$defs/guestDraft" } },
    "loss_cases": { "type": "array", "items": { "$ref": "#/$defs/lossCase" } },
    "log_corrections": { "type": "array", "items": { "$ref": "#/$defs/correction" } },
    "offline_checks": { "type": "array", "items": { "$ref": "#/$defs/offlineCheck" } },
    "manual_fallback_selections": { "type": "array", "items": { "$ref": "#/$defs/manualSelection" } },
    "audit": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/auditEvent" } }
  },
  "$defs": {
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "credential_id", "carrier", "static_capture", "accepted_by_demo_reader", "official_access_granted", "reason", "occurred_at"],
      "properties": {
        "id": { "type": "string" },
        "credential_id": { "type": "string" },
        "carrier": { "type": "string" },
        "static_capture": { "type": "boolean" },
        "accepted_by_demo_reader": { "type": "boolean" },
        "official_access_granted": { "const": false },
        "reason": { "type": "string" },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "credential_id", "zone_id", "purpose", "status", "missing_prerequisite_ids", "authoritative", "experience_executed_access", "official_action_url", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "credential_id": { "type": "string" },
        "zone_id": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string" },
        "missing_prerequisite_ids": { "type": "array", "items": { "type": "string" } },
        "authoritative": { "const": false },
        "experience_executed_access": { "const": false },
        "official_action_url": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "guestDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "zone_id", "purpose", "sponsor_label", "duration_hours", "extra_approval_required", "auto_expires", "status", "authoritative"],
      "properties": {
        "id": { "type": "string" },
        "zone_id": { "type": "string" },
        "purpose": { "type": "string" },
        "sponsor_label": { "type": "string" },
        "duration_hours": { "type": "integer", "minimum": 1 },
        "extra_approval_required": { "type": "boolean" },
        "auto_expires": { "const": true },
        "status": { "const": "draft" },
        "authoritative": { "const": false }
      }
    },
    "lossCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "credential_id", "requested_action", "status", "official_action_url", "experience_executed_action", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "credential_id": { "type": "string" },
        "requested_action": { "enum": ["freeze", "report_lost", "restore"] },
        "status": { "const": "draft_ready_for_official_channel" },
        "official_action_url": { "type": "string", "format": "uri" },
        "experience_executed_action": { "const": false },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "record_id", "reason", "status", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "record_id": { "type": "string" },
        "reason": { "type": "string", "minLength": 8 },
        "status": { "const": "submitted" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "offlineCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "credential_id", "zone_id", "carrier", "valid", "cryptographically_verified", "official_access_granted", "reason", "checked_at"],
      "properties": {
        "id": { "type": "string" },
        "credential_id": { "type": "string" },
        "zone_id": { "type": "string" },
        "carrier": { "type": "string" },
        "valid": { "type": "boolean" },
        "cryptographically_verified": { "const": false },
        "official_access_granted": { "const": false },
        "reason": { "type": "string" },
        "checked_at": { "type": "string", "format": "date-time" }
      }
    },
    "manualSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fallback_id", "reason", "status", "official_action_url", "experience_executed_access", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "fallback_id": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "const": "handoff_ready" },
        "official_action_url": { "type": "string", "format": "uri" },
        "experience_executed_access": { "const": false },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "auditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "action", "target_id", "detail", "occurred_at", "previous_event_hash", "event_hash"],
      "properties": {
        "id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "action": { "type": "string" },
        "target_id": { "type": "string" },
        "detail": { "type": "string" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "previous_event_hash": { "type": ["string", "null"] },
        "event_hash": { "type": "string" }
      }
    }
  }
}
