{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TianBingzhuo/Jiaowu2K26/app/contracts/v1/course-pack.schema.json",
  "title": "University2K26 complete public-safe demo course pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_mode",
    "course",
    "source_coverage",
    "teaching_loop",
    "units",
    "labs",
    "assessments",
    "invariants"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "data_mode": { "const": "public_safe_demo" },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "title_zh", "title_en", "goal", "source_boundary"],
      "properties": {
        "id": { "const": "signal-linear-systems" },
        "code": { "const": "SLS 240" },
        "title_zh": { "const": "信号与线性系统" },
        "title_en": { "const": "Signals and Linear Systems" },
        "goal": { "type": "string", "minLength": 1 },
        "source_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_files",
        "structured_files",
        "visually_reviewed_pages",
        "reviewed_pages_total",
        "read_depth",
        "privacy_exclusions",
        "audit_ids"
      ],
      "properties": {
        "original_files": { "const": 6 },
        "structured_files": { "const": 6 },
        "visually_reviewed_pages": { "const": 65 },
        "reviewed_pages_total": { "const": 65 },
        "read_depth": { "enum": ["B+S", "A+B+S"] },
        "privacy_exclusions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "audit_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "teaching_loop": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "purpose"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "why", "objectives", "lessons", "knowledge_nodes"],
        "properties": {
          "id": { "type": "string", "pattern": "^unit-" },
          "title": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "objectives": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "lessons": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "duration_minutes", "sequence"],
              "properties": {
                "id": { "type": "string", "pattern": "^lesson-" },
                "title": { "type": "string", "minLength": 1 },
                "duration_minutes": { "type": "integer", "minimum": 10, "maximum": 90 },
                "sequence": {
                  "type": "array",
                  "minItems": 3,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "knowledge_nodes": {
            "type": "array",
            "minItems": 7,
            "items": { "$ref": "#/$defs/knowledgeNode" }
          }
        }
      }
    },
    "labs": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "deliverable", "evidence", "safety"],
        "properties": {
          "id": { "type": "string", "pattern": "^lab-" },
          "title": { "type": "string", "minLength": 1 },
          "deliverable": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "safety": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "mode", "checks", "feedback"],
        "properties": {
          "id": { "type": "string", "pattern": "^assessment-" },
          "title": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["diagnostic", "practice", "lab", "oral_replay", "capstone"] },
          "checks": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "feedback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_courseware_copied",
        "private_identity_included",
        "manual_answer_save_required",
        "formal_grade_impact",
        "teacher_review_required"
      ],
      "properties": {
        "original_courseware_copied": { "const": false },
        "private_identity_included": { "const": false },
        "manual_answer_save_required": { "const": false },
        "formal_grade_impact": { "const": false },
        "teacher_review_required": { "const": true }
      }
    }
  },
  "$defs": {
    "knowledgeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "prerequisite_ids",
        "explanation",
        "misconception",
        "check",
        "source_refs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^kn-" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["concept", "procedure", "evidence", "boundary"] },
        "prerequisite_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^kn-" }
        },
        "explanation": { "type": "string", "minLength": 1 },
        "misconception": { "type": "string", "minLength": 1 },
        "check": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
