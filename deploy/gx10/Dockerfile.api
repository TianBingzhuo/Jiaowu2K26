FROM rust:1.97.1-bookworm AS build

WORKDIR /workspace
COPY rust-toolchain.toml ./
COPY app ./app
RUN cargo build \
    --release \
    --locked \
    --manifest-path app/Cargo.toml \
    --bin j2k26-api

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /nonexistent --shell /usr/sbin/nologin j2k26 \
    && mkdir -p /var/lib/university2k26 \
    && chown j2k26:j2k26 /var/lib/university2k26

COPY --from=build /workspace/app/target/release/j2k26-api /usr/local/bin/j2k26-api

USER 10001:10001
WORKDIR /var/lib/university2k26
ENV J2K26_BIND=127.0.0.1:3000
ENV J2K26_DATABASE_URL=sqlite:///var/lib/university2k26/j2k26.db?mode=rwc
ENV RUST_LOG=info

ENTRYPOINT ["/usr/local/bin/j2k26-api"]
